{
  "manifest_version": 3,
  "name": "Annot — site to source",
  "version": "0.1.1",
  "description": "Annotate live elements and copy a prompt grounded in your local project.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Annot on this page", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "minimum_chrome_version": "102"
}
